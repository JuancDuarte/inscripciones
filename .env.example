# ---------------------------------------------------------------
# Módulo Inscripciones - variables de entorno
# Copia este archivo a ".env" (está en .gitignore); docker compose lo lee solo.
# En AWS la contraseña de la BD sale de Secrets Manager (lab4/db-inscripciones).
# ---------------------------------------------------------------

# Base de datos PROPIA del módulo (usuario y contraseña exclusivos)
DB_NAME=inscripciones_db
DB_USER=inscripciones_user
DB_PASSWORD=CAMBIA-ESTA-CLAVE-DE-BD

# Otros módulos (consistencia por HTTP, sin llaves foráneas)
#   docker compose de este repo: los módulos corren en tu máquina
#   AWS: http://estudiantes.lab4.local:3001 y http://materias.lab4.local:8081
ESTUDIANTES_URL=http://host.docker.internal:3001
MATERIAS_URL=http://host.docker.internal:8081
